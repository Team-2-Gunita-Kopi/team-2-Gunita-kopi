# Gunita Kopi POS: copy to .env.local (local) or set in Vercel (Preview / Production).

# Supabase, public (browser-visible): project URL and publishable key.
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key

# Server only. Never add a NEXT_PUBLIC_ prefix. Used only by src/server.
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-do-not-expose
# One-time Owner setup code (32+ chars). Remove after the Owner exists.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OWNER_SETUP_TOKEN=
# 32+ random characters: lets the sign-in route trust the client IP passed by the session handlers.
INTERNAL_PROXY_SECRET=
# Only when NOT on Vercel: header your reverse proxy sets with the client IP (e.g. x-real-ip).
TRUSTED_CLIENT_IP_HEADER=

# Demo mode (local only; refused in production builds): sample data, no Supabase needed.
NEXT_PUBLIC_USE_MOCKS=false
MOCK_MODE=false
