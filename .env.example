# Gunita Kopi POS - Environment Variables Example
# Duplicate this file as .env.local in the relevant app folder or set in Vercel.

# Supabase Public Configuration (used by admin, pos, api)
NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9

# API URL (used by admin, pos)
NEXT_PUBLIC_API_URL=http://localhost:3002

# Server-only secrets (API only - NEVER expose to browser or admin/pos apps)
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-do-not-expose

# CORS Allowed Origins (API only - comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001
