# POS Website Environment Variables (Client & SSR only)
# NOTE: SUPABASE_SERVICE_ROLE_KEY must NEVER be added to this file or application.

NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9
NEXT_PUBLIC_API_URL=http://localhost:3002

# Server only (never NEXT_PUBLIC_): the site signs in and proxies /api/* through these.
# API base URL for server-to-server calls (defaults to NEXT_PUBLIC_API_URL).
API_URL=
# Same value as INTERNAL_PROXY_SECRET in apps/api (32+ random characters).
INTERNAL_PROXY_SECRET=
# Only when NOT on Vercel: header your reverse proxy sets with the client IP (e.g. x-real-ip).
TRUSTED_CLIENT_IP_HEADER=
