# Backend API Environment Variables (Server only)

NEXT_PUBLIC_SUPABASE_URL=https://placeholder-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=placeholder-anon-key-eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9

# Service role key - strictly confined to apps/api server code
SUPABASE_SERVICE_ROLE_KEY=placeholder-service-role-key-do-not-expose

# CORS allowed origins (comma-separated)
# Demo mode only (/api/mock/rpc). Real traffic never needs CORS: browsers never call the API.
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001

# One-time Owner setup code (32+ chars). Required outside localhost development; remove after the Owner exists.
# Generate: node -e "console.log(require('crypto').randomBytes(24).toString('base64url'))"
OWNER_SETUP_TOKEN=

# Same value as INTERNAL_PROXY_SECRET in apps/admin and apps/pos (32+ random characters).
INTERNAL_PROXY_SECRET=
# Only when NOT on Vercel: header your reverse proxy sets with the client IP (e.g. x-real-ip).
TRUSTED_CLIENT_IP_HEADER=
# Dev only; a production build refuses mock mode even if this is set.
# Dev-only shared mock service (POST /api/mock/rpc)
MOCK_MODE=true
